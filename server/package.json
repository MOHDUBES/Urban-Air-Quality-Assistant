{
  "name": "@aqa/server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "build": "esbuild index.js --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:coverage": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --coverage --runInBand --forceExit",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "cors": "^2.8.5",
    "esbuild": "^0.28.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
